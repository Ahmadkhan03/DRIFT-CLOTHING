# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored. Never commit real keys.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The *secret* key (sb_secret_...) or legacy service_role key. Server-only, never expose.
SUPABASE_SECRET_KEY=

# Public site URL, used in email links (e.g. https://drift.pk). Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Order confirmation emails via https://resend.com (optional; emails are skipped if empty)
RESEND_API_KEY=
EMAIL_FROM="DRIFT <orders@yourdomain.com>"
